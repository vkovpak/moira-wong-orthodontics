{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mw/footer-text",
	"title": "Footer Text",
	"category": "mw",
	"description": "A rich text area of the site footer (paragraphs, lists, links), with an optional decorative icon.",
	"parent": [ "mw/site-footer" ],
	"textdomain": "moira-wong-orthodontics",
	"attributes": {
		"hasIcon": { "type": "boolean", "default": false },
		"iconId": { "type": "number" },
		"iconUrl": { "type": "string", "default": "" },
		"iconAlt": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
