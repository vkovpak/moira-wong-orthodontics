{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mw/faq",
	"title": "FAQ",
	"category": "mw",
	"icon": "editor-help",
	"description": "A heading, numbered question cards (4, 3 or 2 per row) and a button below them.",
	"keywords": [ "faq", "questions", "answers" ],
	"textdomain": "moira-wong-orthodontics",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"title": {
			"type": "string",
			"source": "html",
			"selector": ".mw-faq__title"
		},
		"perRow": {
			"type": "number",
			"default": 4
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "full" ]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
