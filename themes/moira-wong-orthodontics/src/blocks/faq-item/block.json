{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mw/faq-item",
	"title": "Question",
	"category": "mw",
	"icon": "editor-help",
	"description": "One question with its answer, numbered automatically.",
	"parent": [ "mw/faq" ],
	"textdomain": "moira-wong-orthodontics",
	"attributes": {
		"question": {
			"type": "string",
			"source": "html",
			"selector": ".mw-faq-item__question"
		},
		"answer": {
			"type": "string",
			"source": "html",
			"selector": ".mw-faq-item__answer"
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
