{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mw/contact-form",
	"title": "Contact Form",
	"category": "mw",
	"icon": "email",
	"description": "A heading band, a text above a Contact Form 7 form and a photo in the bottom left corner.",
	"keywords": [ "contact", "form", "register", "enquiry", "cf7" ],
	"textdomain": "moira-wong-orthodontics",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"hasPhoto": {
			"type": "boolean",
			"default": true
		},
		"photoPosition": {
			"type": "string",
			"default": "left"
		},
		"mediaId": {
			"type": "number"
		},
		"mediaUrl": {
			"type": "string",
			"source": "attribute",
			"selector": ".mw-contact__image img",
			"attribute": "src",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"source": "attribute",
			"selector": ".mw-contact__image img",
			"attribute": "alt",
			"default": ""
		},
		"title": {
			"type": "string",
			"source": "html",
			"selector": ".mw-contact__title"
		},
		"formShortcode": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "full" ]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
