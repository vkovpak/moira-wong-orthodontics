{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mw/header-text",
	"title": "Header Text",
	"category": "mw",
	"description": "Single-line text field of the site header with basic formatting and links.",
	"parent": [ "mw/site-header" ],
	"textdomain": "moira-wong-orthodontics",
	"attributes": {
		"content": {
			"type": "string",
			"source": "html",
			"selector": "p",
			"default": ""
		},
		"placeholder": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false
	},
	"editorScript": "file:./index.js"
}
