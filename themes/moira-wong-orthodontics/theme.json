{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Moira Wong Orthodontics",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{ "slug": "base", "name": "White", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Slate", "color": "#252f37" },
				{ "slug": "primary", "name": "Yellow", "color": "#e8ce2c" },
				{ "slug": "amber", "name": "Amber", "color": "#edba3d" },
				{ "slug": "primary-line", "name": "Yellow Line", "color": "#f3e58e" },
				{ "slug": "primary-dark", "name": "Yellow Dark", "color": "#dfc318" },
				{ "slug": "primary-light", "name": "Yellow Light", "color": "#f0da46" },
				{ "slug": "link-hover", "name": "Link Hover Brown", "color": "#8a4516" },
				{ "slug": "accent", "name": "Pale Yellow", "color": "#f9f1be" },
				{ "slug": "cream", "name": "Cream", "color": "#fdf9e6" },
				{ "slug": "cream-light", "name": "Cream Light", "color": "#fdfbed" },
				{ "slug": "cream-dark", "name": "Cream Dark", "color": "#fbf7dd" },
				{ "slug": "background", "name": "Off White", "color": "#f7f7f7" },
				{ "slug": "grey-light", "name": "Light Grey", "color": "#cdcdcd" },
				{ "slug": "grey-medium", "name": "Medium Grey", "color": "#878786" }
			],
			"gradients": [
				{
					"slug": "hero",
					"name": "Hero Yellow",
					"gradient": "linear-gradient(90deg, #dfc318 0%, #e5cb27 45%, #f0da46 100%)"
				}
			],
			"custom": true,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "assistant",
					"name": "Assistant",
					"fontFamily": "Assistant, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Assistant",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/assistant-variable.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "1.4rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "clamp(1.4rem, 1.4rem + ((1vw - 0.32rem) * 0.227), 1.6rem)", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "clamp(1.4rem, 1.4rem + ((1vw - 0.32rem) * 0.455), 1.8rem)", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "clamp(1.4rem, 1.4rem + ((1vw - 0.32rem) * 0.682), 2rem)", "fluid": false },
				{ "slug": "x-large", "name": "X-Large", "size": "clamp(2rem, 2rem + ((1vw - 0.32rem) * 0.455), 2.4rem)", "fluid": false },
				{ "slug": "xx-large", "name": "XX-Large", "size": "clamp(2.8rem, 2.8rem + ((1vw - 0.32rem) * 0.909), 3.6rem)", "fluid": false },
				{ "slug": "huge", "name": "Huge", "size": "clamp(3.2rem, 3.2rem + ((1vw - 0.32rem) * 0.909), 4rem)", "fluid": false }
			],
			"defaultFontSizes": false
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.8rem" },
				{ "slug": "20", "name": "2", "size": "0.7rem" },
				{ "slug": "30", "name": "3", "size": "1.1rem" },
				{ "slug": "40", "name": "4", "size": "1.6rem" },
				{ "slug": "50", "name": "5", "size": "2.4rem" },
				{ "slug": "60", "name": "6", "size": "3.6rem" },
				{ "slug": "70", "name": "7", "size": "5.4rem" },
				{ "slug": "80", "name": "8", "size": "8.1rem" }
			],
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		},
		"blocks": {
			"core/image": {
				"lightbox": { "enabled": false }
			}
		},
		"custom": {
			"gutter": "3rem",
			"radius": {
				"card": "4px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--assistant)",
			"fontSize": "1.8rem",
			"fontWeight": "400",
			"lineHeight": "1.5"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			},
			"blockGap": "0"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "300",
					"lineHeight": "1.25"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "clamp(2.4rem, 5.5vw, 3.2rem)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"link": {
				"color": { "text": "currentColor" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--link-hover)" },
					"typography": { "textDecoration": "none" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontSize": "1.6rem",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": { "top": "1.5rem", "right": "2rem", "bottom": "1.5rem", "left": "2rem" }
				},
				"border": { "radius": "6px" }
			}
		},
		"blocks": {
			"core/buttons": { "spacing": { "blockGap": "1.1rem" } },
			"core/paragraph": { "typography": { "lineHeight": "1.6" } }
		}
	}
}
